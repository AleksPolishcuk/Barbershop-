# Optional override for a custom HTTPS domain. The Vercel production domain is detected automatically, with this demo URL as a fallback.
# Set this when reusing the template for another client.
NEXT_PUBLIC_SITE_URL=
# Optional: add only confirmed customer-facing details
NEXT_PUBLIC_BUSINESS_NAME=BLADE Barbershop
NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_PHONE=
# Optional WhatsApp Business number for booking requests, digits only with country code.
# Example format: 358401234567. Leave empty for the safe demo/copy mode.
NEXT_PUBLIC_BOOKING_WHATSAPP_NUMBER=
# Real booking: one shop-owned hosted booking URL, e.g. https://varaa.timma.fi/yourbusinessname
# When set, every Book Appointment action goes there instead of opening the demo form.
NEXT_PUBLIC_BOOKING_PROVIDER_URL=
